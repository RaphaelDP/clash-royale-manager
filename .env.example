# ================================================================================
# .env.example — copy this file to .env (our reanem this file ".env") and fill in your own values.
# The .env file contains secrets and must never be committed.
# ================================================================================

# Clash Royale API token — get one at https://developer.clashroyale.com
CR_API_TOKEN=

# Your clan tag, including the # (e.g. #ABC123)
CLAN_TAG=

# Database connection. Default (SQLite, stored locally) works out of the box.
DATABASE_URL=sqlite:///data/clan_manager.db

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/clan_manager.log

# Timezone used for scheduled jobs (snapshots, scores, reports, backups)
SCHEDULER_TIMEZONE=Europe/Paris

# Optional: Discord webhook URL for the daily activity report.
# Leave blank to disable Discord notifications.
DISCORD_WEBHOOK_URL=